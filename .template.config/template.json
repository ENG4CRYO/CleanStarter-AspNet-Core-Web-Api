{
  "$schema": "http://json.schemastore.org/template",
  "author": "Mustafa Aqel",
  "classifications": [ "Web", "WebAPI", "Clean Architecture" ],
  "name": "Clean Architecture Starter",
  "identity": "CleanStarter.Template",
  "shortName": "cleanstarter",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "CleanStarter",
  "preferNameDirectory": true,
  "symbols": {
    "ArchitecturePattern": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "Repository",
          "description": "Use Unit of Work and Read/Write Repositories"
        },
        {
          "choice": "CQRS",
          "description": "Use CQRS pattern with MediatR"
        }
      ],
      "defaultValue": "Repository",
      "description": "Choose the data access architecture pattern."
    },
    "IsRepository": {
      "type": "computed",
      "value": "(ArchitecturePattern == \"Repository\")"
    },
    "IsCQRS": {
      "type": "computed",
      "value": "(ArchitecturePattern == \"CQRS\")"
    },
    "UseOTP": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include OTP based Authentication."
    },
    "UseFirebaseAppCheck": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include Firebase App Check Middleware."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!IsRepository)",
          "exclude": [
            "**/CleanStarter.Application/Interfaces/RepositoryInterfaces/**",
            "**/CleanStarter.Infrastructure/Repositories/**"
          ]
        },
        {
          "condition": "(!IsCQRS)",
          "exclude": [
            "**/CleanStarter.Application/Commands/**",
            "**/CleanStarter.Application/Queries/**"
          ]
        }
      ]
    }
  ]
}